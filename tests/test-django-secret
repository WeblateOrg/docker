#!/bin/bash
# Exercise the secret startup functions against a temporary data directory.
set -eu

# Root bypasses permission bits; run these cases as an unprivileged user.
if ((EUID == 0)); then
    test_root=$(mktemp -d)
    trap 'rm -rf "$test_root"' EXIT HUP INT TERM
    mkdir "$test_root/tests"
    cp start "$test_root/start"
    cp "$0" "$test_root/tests/test-django-secret"
    chmod -R a+rX "$test_root"
    setpriv --reuid=65534 --regid=65534 --clear-groups \
        bash -c 'cd "$1"; bash tests/test-django-secret' bash "$test_root"
    exit 0
fi

test_dir=$(mktemp -d)
trap 'rm -rf "$test_dir"' EXIT HUP INT TERM

awk '/^ensure_django_secret\(\) \{/,/^\}/; /^django_secret_ready\(\) \{/,/^\}/; /^wait_for_django_secret\(\) \{/,/^\}/' start \
    | sed "s|/app/data|$test_dir|g" > "$test_dir/functions.sh"
# shellcheck source=/dev/null
. "$test_dir/functions.sh"

if django_secret_ready; then
    echo 'Missing secret was considered ready' >&2
    exit 1
fi

touch "$test_dir/secret"
if django_secret_ready; then
    echo 'Empty secret was considered ready' >&2
    exit 1
fi

printf 'existing-secret\n' > "$test_dir/secret"
chmod 644 "$test_dir/secret"
if django_secret_ready; then
    echo 'Writable secret needed permission repair but was considered ready' >&2
    exit 1
fi
ensure_django_secret
[[ $(stat -c %a "$test_dir/secret") == 600 ]]
django_secret_ready

# Owners can repair permissions even when the file is not writable.
for mode in 444 000 040; do
    chmod "$mode" "$test_dir/secret"
    if [[ $mode != 444 ]] && django_secret_ready; then
        echo 'Unreadable secret was considered ready' >&2
        exit 1
    fi
    ensure_django_secret
    [[ $(stat -c %a "$test_dir/secret") == 600 ]]
    [[ $(cat "$test_dir/secret") == existing-secret ]]
    wait_for_django_secret
done
