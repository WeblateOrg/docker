#!/bin/sh

# SPDX-License-Identifier: GPL-3.0-or-later

set -eu

mode=${1:?Usage: sign-image-tags MODE}
workflow_ref=${GITHUB_WORKFLOW_REF:?GITHUB_WORKFLOW_REF is required}
metadata_file=${BUILDX_METADATA_FILE:-/tmp/buildx-metadata.json}
digest=$(jq --raw-output '."containerimage.digest" // empty' "$metadata_file")

if [ -z "$digest" ]; then
    echo "Unable to find containerimage.digest in $metadata_file" >&2
    exit 1
fi

tags=$(.github/bin/get-image-tags "$mode")
signed_repositories=

for tag in $tags; do
    repository=${tag%:*}
    case " $signed_repositories " in
    *" $repository "*)
        continue
        ;;
    esac
    image="$repository@$digest"
    if cosign verify \
        --certificate-identity "https://github.com/$workflow_ref" \
        --certificate-oidc-issuer https://token.actions.githubusercontent.com \
        "$image" > /dev/null 2>&1; then
        echo "Already signed: $image"
    else
        cosign sign --yes "$image"
    fi
    signed_repositories="$signed_repositories $repository"
done
